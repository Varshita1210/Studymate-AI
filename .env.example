# ==============================================================================
# STUDYMATE AI - Environment Variables
# ==============================================================================
# 1. Obtain an API key from Google AI Studio: https://aistudio.google.com/
# 2. Copy this file to a new file named .env in the root directory:
#      cp .env.example .env
# 3. Replace the placeholder below with your real Google AI Studio API key.
# ==============================================================================

# Required: Your Google AI Studio API key (Keep this secret and never commit to Git)
GEMINI_API_KEY=your_api_key_here

# Verified Supported Model: Gemma 4 26B A4B IT (Default)
# Verified compatible with text generation and structured JSON quiz schema
GEMINI_MODEL=gemma-4-26b-a4b-it

# Server Port
PORT=3000
